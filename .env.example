# Contact form configuration.
#
# This project posts to a hosted form endpoint. By default it targets Web3Forms
# (https://web3forms.com), which needs no backend — just a public access key.
#
#   1. Create a free access key at https://web3forms.com
#   2. Copy this file to `.env` and fill in the values below.
#
# To use a different provider, change VITE_CONTACT_ENDPOINT to their submit URL
# and set VITE_CONTACT_ACCESS_KEY to whatever key that provider expects.

VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
VITE_CONTACT_ACCESS_KEY=your-access-key-here
